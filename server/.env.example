# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# Phase 2 cluster identity (optional). Empty INSTANCE_ID → hostname-pid-random.
# INSTANCE_PUBLIC_URL = this process base URL (no trailing slash); only needed if a
# second API ever uses Redis watch redirects.
# INSTANCE_ID=api-a
# INSTANCE_PUBLIC_URL=http://192.168.88.35:8000

# Redis (employee secrets + live-stream: presence, tickets, publisher registry)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=alpha_ai
DB_PASSWORD=alpha_ai_secret
DB_NAME=alpha_ai_tracker
DB_SSLMODE=disable
# ONE PostgreSQL only — size pool so sum(API+worker+sfu MaxConns) < max_connections.
DB_MAX_OPEN_CONNS=40
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# ─── Scale (~1000 agents / 100 live watches / 100 admins) ───
# Asynq background jobs (requires Redis). Embed in API for single-VPS, or ASYNQ_EMBED=false + `go run ./cmd/worker`.
ASYNQ_ENABLED=true
ASYNQ_EMBED=true
ASYNQ_CONCURRENCY=8
# 0 = derive ~60% of DB_MAX_OPEN_CONNS. Excess sync POSTs get 503 + Retry-After.
SYNC_MAX_CONCURRENT=0
RATE_LIMIT_LOGIN_RPS=2
RATE_LIMIT_LOGIN_BURST=5
RATE_LIMIT_SYNC_RPS=30
RATE_LIMIT_SYNC_BURST=60
RATE_LIMIT_ADMIN_RPS=20
RATE_LIMIT_ADMIN_BURST=40
DASHBOARD_CACHE_TTL_SEC=20

# JWT Authentication
JWT_SECRET=change-this-to-a-very-long-random-secret-key
# Web admin access token (auth_token cookie) - short-lived, re-minted by the refresh flow
JWT_ACCESS_EXPIRY=15m
# Web admin refresh token (refresh_token cookie) - rotates on every refresh
JWT_REFRESH_EXPIRY=720h
# Desktop client employee-login JWT (sent in sync request bodies, no refresh mechanism)
JWT_EMPLOYEE_ACCESS_EXPIRY=24h

# Company Admin (auto-initialized on first run)
ADMIN_EMAIL=clickmasters@gmail.com
ADMIN_PASSWORD=Clickmasters@1234
ADMIN_NAME=Company Admin

# CORS — list every origin the admin UI is opened from (scheme+host+port).
# Live-stream WebSocket CheckOrigin uses the same list.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=info

# Staleness threshold (days) for employee↔app/package links (is_active = false)
LINK_STALE_DAYS=7

# IANA timezone for shifts still on the migration default UTC (e.g. Asia/Karachi).
# Applied on server boot and used when creating shifts with no timezone.
DEFAULT_SHIFT_TIMEZONE=Asia/Karachi

# One-time Windows agent protected stop/uninstall code TTL (minutes)
DLP_REMOVAL_CODE_TTL_MIN=60

# 3-state app_sessions lifecycle (2026-09-02 sweep job in jobs/session_lifecycle_sweep.go)
#   ACTIVE  -> STALE   when last_sync_at is older than SESSION_STALE_AFTER_MINUTES (no heartbeat)
#   STALE   -> CLOSED  when last_sync_at is older than SESSION_CLOSE_AFTER_HOURS  (terminal)
# A live client re-uploading any ended_at=NULL row promotes STALE/CLOSED back to ACTIVE
# in the upsert, so a network outage never destroys information that may still exist on the client.
SESSION_STALE_AFTER_MINUTES=10
SESSION_CLOSE_AFTER_HOURS=24

# Live stream — WebRTC SFU screen preview (no JPEG / no DB storage)
LIVE_STREAM_ENABLED=true
# Max concurrent watched publishers (product target 100). Lower on small VPS NICs.
LIVE_STREAM_MAX_STREAMS=100
LIVE_STREAM_MAX_WATCHERS_PER_EMPLOYEE=10
LIVE_STREAM_IDLE_SEC=90
# Cap advertised for ops; also enforced on subscriber RTPSender encodings (Phase 1.3b).
# Client encode uses ALPHA_STREAM_MAX_BITRATE_KBPS (ScreenVp8Encoder) + uplink ladder.
# Screen-share needs ~8–12 Mbps + ~1s keyframes for sharp UI text on good links.
WEBRTC_MAX_BITRATE_KBPS=12000
# Comma-separated STUN URLs (defaults to Google public STUN)
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# TURN is REQUIRED for public-internet / VPS deploys (CGNAT, enterprise firewalls, UDP blocks).
# Without TURN, many remote employees never get ICE — black tiles, not a degraded stream.
# Relay cost is ~2× media bandwidth on the bad path. Prefer time-limited HMAC credentials
# (coturn use-auth-secret) over a long-lived open relay.
# WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# WEBRTC_TURN_USER=
# WEBRTC_TURN_PASS=

# Control / presence WebSocket (GET /api/v1/ws) — keep-alive channel for clients.
# Independent of LIVE_STREAM_*. Server accepts by default; clients opt in via ALPHA_WS_ENABLED.
PRESENCE_WS_ENABLED=true
# Hard cap on simultaneous control sockets (one per employee; reconnect replaces).
PRESENCE_WS_MAX_CONNECTIONS=10000

# ─── Client installers / auto-update ────────────────────────────────────────
# Folder holding client installers, e.g. setup/v1.0.0.exe (also .deb / .dmg).
# The version comes from the filename (first X.Y.Z). Optional release notes:
# setup/v1.0.0.md. Powers GET /api/v1/releases and GET /api/v1/downloads/:assetId
# (no login). Desktop clients poll it every minute and self-update when a newer
# version appears. Relative paths resolve from the working dir, then the binary dir.
RELEASES_DIR=setup
# Cap simultaneous installer body streams (fleet admission). Excess GETs get 429 + Retry-After.
RELEASE_DOWNLOAD_MAX_CONCURRENT=25
RELEASE_DOWNLOAD_RETRY_AFTER_SEC=60

# ─── Offline-first screenshots ──────────────────────────────────────────────
# WebP files: media/screenshots/{empID}/{yyyy}/{MM}/{dd}/…. No retention purge yet.
SCREENSHOTS_DIR=media/screenshots
SCREENSHOTS_MAX_UPLOAD_BYTES=2097152
# Soft per-IP rate limit for DeviceAuth POST /screenshots/upload
RATE_LIMIT_SCREENSHOT_RPS=40
RATE_LIMIT_SCREENSHOT_BURST=80


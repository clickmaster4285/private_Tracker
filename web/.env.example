# REST API base (includes /api/v1). Public /releases downloads use the same host
# via GET /releases and GET /downloads/:assetId (installers from the API host setup/ folder).
# Leave unset in normal use: the browser calls the relative /api/v1, which Next.js
# rewrites to API_PROXY_TARGET (same-site, so the httpOnly auth cookies are sent).
# Setting it to another host (e.g. http://192.168.88.44:8000/api/v1) makes the calls
# cross-site: SameSite=Lax cookies are dropped and /auth/refresh always returns 401.
# NEXT_PUBLIC_API_URL=
# Go API root (no /api/v1) the Next.js server proxies to. Server-side only.
API_PROXY_TARGET=http://localhost:8080

# Live Stream WebSocket base URL (no path). Next.js rewrites do not proxy WS.
# Dev: point at the Go server directly. Prod: same host as the API via reverse proxy.
NEXT_PUBLIC_WS_URL=ws://localhost:8080

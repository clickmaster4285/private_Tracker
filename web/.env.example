# Go API base for Next.js rewrites (scheme://host:port or …/api/v1).
# The browser always calls relative /api/v1 (same-site httpOnly cookies).
# Do not make client fetch() hit this host directly — that drops SameSite=Lax cookies.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Live Stream WebSocket base URL (no path). Plain HTTP API → ws://.
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Local HTTPS (mkcert). `npm run dev` reads these via scripts/dev-https.mjs.
TLS_CERT_FILE=../certs/local.pem
TLS_KEY_FILE=../certs/local-key.pem
TLS_CA_FILE=../certs/rootCA.pem
NODE_EXTRA_CA_CERTS=../certs/rootCA.pem

# Leave unset in normal use: the browser calls relative /api/v1, which Next.js
# rewrites to API_PROXY_TARGET (same-site, so httpOnly auth cookies are sent).
# Setting NEXT_PUBLIC_API_URL to another host makes calls cross-site and drops
# SameSite=Lax cookies → /auth/refresh 401.
# NEXT_PUBLIC_API_URL=

# Go API root (scheme://host:port, no /api/v1) the Next.js server proxies to.
API_PROXY_TARGET=https://localhost:8080

# Live Stream WebSocket base URL (no path). Use wss:// when the API is HTTPS.
NEXT_PUBLIC_WS_URL=wss://localhost:8080

# Leave unset in normal use: the browser calls relative /api/v1, which Next.js
# rewrites to API_PROXY_TARGET (same-site, so httpOnly auth cookies are sent).
# Setting NEXT_PUBLIC_API_URL to another host makes calls cross-site and drops
# SameSite=Lax cookies → /auth/refresh 401.
# NEXT_PUBLIC_API_URL=

# Go API root (scheme://host:port, no /api/v1) the Next.js server proxies to.
# Keep http:// even when the UI is started with `npm run dev:https` — the
# rewrite is server-side (Node → API), so mixed scheme is fine.
API_PROXY_TARGET=http://localhost:8080

# Live Stream WebSocket base URL (no path). Plain HTTP API → ws://.
# From an https:// UI, some browsers block ws:// (mixed content); live-stream
# may need the API on wss:// for that path. Login/REST still work via the proxy.
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Alpha AI Tracker — Client Configuration
# Copy this to .env and fill in values

# Unique machine identifier (leave empty for auto-generate)
ALPHA_CLIENT_ID=

# SQLite database path (relative or absolute)
ALPHA_DB_PATH=data/alpha_tracker.db

# Encryption key for SQLite (leave empty if not encrypting)
# Use: openssl rand -hex 32
ALPHA_DB_ENCRYPTION_KEY=

# Log collection interval in seconds (default: 30)
ALPHA_COLLECT_INTERVAL_SEC=30

# Log level: Verbose, Debug, Info, Warn, Error
ALPHA_LOG_LEVEL=Info

# Server URL (for future use — leave empty for local-only mode)
ALPHA_SERVER_URL=
ALPHA_API_KEY=

# GitHub owner/repo for `bash publish/release.sh` (`gh release create --repo`).
# Not baked into installers — release tooling only. Required in .env (or export)
# when releasing: release.sh uses set -euo pipefail and a missing REPO= line
# makes `grep` exit before the script's default can apply (silent abort).
REPO=clickmaster4285/Alpha-AI-Tracker

# ─── Self-update from the Alpha API server ───
# Requires ALPHA_SERVER_URL above. Installers live in the server's setup folder
# (server/setup/v1.0.0.exe, RELEASES_DIR on the API host) and are served by
# GET /api/v1/releases + /api/v1/downloads/:assetId. No GitHub.
#
# Windows: AlphaAITracker.Service (LocalSystem) checks every
# ALPHA_UPDATE_CHECK_INTERVAL_SEC, Range-downloads and silently applies the newer
# installer — no UAC after the first admin install. The same ALPHA_UPDATE_* keys
# are written into %ProgramData%\<APP_MUTEX>\dlp\service.env by the installer.
# Linux: client downloads + pkexec dpkg (password dialog). macOS: opens the dmg.
ALPHA_UPDATE_ENABLED=true
# Seconds between update checks against the server (minimum 15).
ALPHA_UPDATE_CHECK_INTERVAL_SEC=60
# Auto-download + install when a check finds a newer version. Windows: silent via
# the LocalSystem service (no UAC). Linux still shows the polkit password dialog
# (the install dir is root-owned); set false to only notify.
ALPHA_UPDATE_AUTO_INSTALL=true

# ─── Browser journey tracking (Option B — OS accessibility tree) ───
# Master switch. The tracker reads browser windows from the OS accessibility tree
# (AT-SPI on Linux, UI Automation on Windows, Accessibility API on macOS) — the SAME
# way screen readers see the screen. No debugger, no extension, no browser catalog
# dependency. Works on every browser and every Chrome version (incl. Chrome 136+).
ALPHA_BROWSER_TRACKING_ENABLED=true
# How often (seconds) the accessibility tree is polled for the active-tab URL/title.
ALPHA_BROWSER_ACCESSIBILITY_POLL_SECONDS=3
# Close a browser journey after this many idle minutes (window open, no URL/title change).
ALPHA_BROWSER_JOURNEY_IDLE_MINUTES=15
# Capture incognito/private-window URLs. OFF by default: recording private browsing
# requires explicit legal sign-off. When OFF, incognito windows are still detected and
# flagged in metadata, but their URL is not stored.
ALPHA_BROWSER_CAPTURE_INCOGNITO=true

# ─── Browser journey URL fallback (browser profile history DB) ───
# When the accessibility tree cannot expose the active-tab URL (Linux Chrome 136+ unless
# launched with --force-renderer-accessibility; snap Firefox is AppArmor-blocked), the
# tracker reads the browser's OWN profile history database instead (Chromium "History",
# Firefox "places.sqlite") — while the browser is running, no restart/flag/extension.
# Works on all platforms and browsers, including brand-new ones (install→use→uninstall).
# Incognito visits are never written to history DBs, so they stay out automatically.
ALPHA_BROWSER_HISTORY_ENABLED=true
# How often (seconds) browser history databases are re-scanned/re-read (default 10).
ALPHA_BROWSER_HISTORY_POLL_SECONDS=10

# ─── File Explorer journey tracking (Desktop Event Bus) ───
# Captures the user's FILE journey — file-manager navigations (AT-SPI on Linux, Shell
# COM Explorer windows on Windows) and file create/rename/delete/recent-file opens —
# stored as app_items journeys (object_type folder/file, actions navigate/create/
# rename/delete/open). Set to false to collect NO file-journey data at all (browser
# journey tracking is governed separately by ALPHA_BROWSER_TRACKING_ENABLED).
ALPHA_FILE_JOURNEY_ENABLED=true

# ─── USB / peripheral hotplug tracking (local SQLite only) ───
# Records when physical devices (USB drives, phones, keyboards, mice, headsets,
# monitors, chargers) are plugged in / unplugged into the local hardware_devices table.
# Linux-only. Local-only for now — NOT synced to the server yet.
ALPHA_HARDWARE_DEVICES_ENABLED=true

# ─── Software inventory — near-real-time install/uninstall detection ───
# InstalledSoftwareWatcher watches .desktop/dpkg/Start Menu, /Applications and triggers an
# immediate inventory rescan on change — install/uninstall recorded in ~2-5s, no GUI needed.
# Set to false to DISABLE real-time detection entirely (installs/uninstalls then only picked up at next boot).
ALPHA_INVENTORY_WATCH_ENABLED=true

# ─── Sync engine (dedicated SyncService loop — collection never blocks on network) ───
# SyncService drains unsent SQLite rows on its OWN background loop in chunks bounded by
# BOTH row count and payload bytes, gzips request bodies, pauses politely between chunks,
# and backs off exponentially on failure. A 50k+ backlog drains in minutes without
# spiking CPU or adding latency to collection.
# Min wait (seconds) between drain passes when idle (default 60).
ALPHA_SYNC_INTERVAL_SEC=60
# Max rows per chunk (default 1000).
ALPHA_SYNC_MAX_ROWS=1000
# Max serialized payload bytes per chunk, ~1MB (default 1000000).
ALPHA_SYNC_MAX_BYTES=1000000
# Politeness pause (ms) between chunks while draining a backlog (default 150).
ALPHA_SYNC_CHUNK_DELAY_MS=150
# Per-pass time budget (seconds); a huge backlog never monopolizes CPU (default 300).
ALPHA_SYNC_MAX_DURATION_SEC=300
# Exponential-backoff ceiling (seconds) on sync failure (default 300 = 5 min).
ALPHA_SYNC_BACKOFF_MAX_SEC=300
# gzip request bodies (default true; server must run middleware.Decompress).
ALPHA_SYNC_COMPRESSION=true
# Retention: delete synced app_items/app_sessions older than this many hours from the client
# SQLite after they've been sent to the server (default 24). Other tables: uninstalled
# inventory cycles (is_installed=0) and superseded network rows are also pruned once synced.
ALPHA_SYNC_RETENTION_HOURS=24
# Account removal (R4): how long `client --remove-account` waits for the final sync
# drain before wiping anyway (default 120). Bounded so a huge backlog or an offline
# machine never blocks removal forever.
ALPHA_REMOVE_ACCOUNT_SYNC_TIMEOUT_SEC=120

# ─── Time & Attendance (Phase 1, finalplan §3) ───
# Master switch for the T&A client services (SystemEventWatcher, IdleDetector).
ALPHA_TA_ENABLED=true
# Idle detection: seconds of no user input before "idle" starts (default 300).
ALPHA_IDLE_THRESHOLD_SEC=300
# Seconds of no input before "away" starts (used by the A.8 aggregator; default 600).
ALPHA_IDLE_AWAY_THRESHOLD_SEC=600
# How often the OS idle source is polled, in seconds (default 30).
ALPHA_IDLE_POLL_SEC=30
# Screen lock/unlock hysteresis window in seconds — re-locks inside this window
# are suppressed so a flaky screensaver doesn't write 50 rows (default 30).
ALPHA_TA_LOCK_HYSTERESIS_SEC=30
# Session-event sync aggregation window in seconds (default 300 = 5 min).
# Raw OS events are stored one-per-row locally; SyncService buckets them into
# count/firstAt/lastAt payloads before POSTing to the server.
ALPHA_EVENT_AGGREGATION_WINDOW_SEC=300
# Hard ceiling on unsynced session_events rows in local SQLite (default 50000).
# Beyond this, the oldest unsynced rows roll into a single old_data_dropped sentinel.
ALPHA_TA_MAX_LOCAL_ROWS=50000

# ─── GPS & Location (Phase 3, finalplan §16) ───
# Master switch — default OFF. Requires OS location permission when enabled.
# Most office PCs use WiFi/IP positioning (not a GPS chip). IP fallback is coarse.
ALPHA_LOCATION_ENABLED=false
# How often to sample location, in seconds (default 300 = 5 min).
ALPHA_LOCATION_POLL_SEC=300
# Coarse IP geolocation when OS GPS/WiFi is unavailable (often 5–50 km off). Default false.
# ALPHA_LOCATION_IP_FALLBACK=false

# ─── Live stream (WebRTC SFU screen preview) ───
# Master switch — default OFF. Media only while an admin is watching.
ALPHA_STREAM_ENABLED=false
# Capture cadence (12 is a good balance with P-frame encode).
ALPHA_STREAM_FPS=12
# Max frame width (hard-capped at 1920). Wider burns bits without sharper VP8 text.
ALPHA_STREAM_MAX_WIDTH=1920
# Encode bitrate kbps — MUST be applied by ScreenVp8Encoder (SIPSorcery's Vp8Codec
# historically ignored this and encoded at ~256 kbps). Cap is 15000.
ALPHA_STREAM_MAX_BITRATE_KBPS=12000
# Seconds between forced VP8 keyframes (default 1). Keep ≥1 — all-I-frame encode
# starves the bitrate budget and looks blocky on screen text.
ALPHA_STREAM_KEYFRAME_INTERVAL_SEC=1
# Minimum measured uplink (kbps) before the client will publish. Below this floor
# publish is skipped and app_status.stream_skip_reason explains why (no silent slideshow).
# 1.2.35: lowered 2500 → 300 so ~1 Mbps office uplinks still publish (ABR ladder picks
# 500 kbps encode). Raise again if you prefer hard skip over a soft stream.
ALPHA_STREAM_MIN_UPLINK_KBPS=300
# libvpx altref lag (0 = lowest latency; try 1 after A/B on a real stream).
ALPHA_STREAM_VP8_LAG_FRAMES=0
# Dev/QA only — artificial SendVideo delay (ms) to force ABR degrade without NIC
# throttle. Leave 0 / unset in production config.enc. Self-test: set 100, watch
# logs for "degrade bitrate → …" then resolution/fps.
# ALPHA_STREAM_DEBUG_SEND_DELAY_MS=0

# ─── Control WebSocket (presence / keep-alive — NOT screen preview) ───
# Separate instance from LiveStreamClient (like Terms vs tracking). Opens a
# long-lived WS to GET /api/v1/ws after login; drives instant Online/Offline
# on the live-stream admin page via wsConnected. Independent of ALPHA_STREAM_*.
# Master switch — enable in .env (and re-bake config.enc for installers).
ALPHA_WS_ENABLED=false
# Application-level ping interval while connected (default 30).
ALPHA_WS_PING_SEC=30
# Initial reconnect backoff in seconds; doubles up to 60 (default 2).
ALPHA_WS_RECONNECT_BASE_SEC=2

# ─── Security & DLP (Windows SYSTEM service — plan.md) ───
# Service / pipe / ProgramData folder names come from client/APP_IDENTIFIERS
# (WINDOWS_SERVICE_NAME, WINDOWS_DLP_PIPE_NAME, APP_MUTEX) — do not hardcode them.
# Master switch for privileged DLP (Windows LocalSystem + Linux root systemd
# alpha-ai-tracker-dlp.service). Lab: true. Ship via service.env (.deb postinst /
# install-service.ps1 / Inno). Re-bake config.enc when shipping.
ALPHA_DLP_ENABLED=true
# DLP policy pull interval (seconds). Ship/default: 300.
# Baked at build into config.enc + Windows service.env; Linux merges into
# /var/lib/<pkg>/dlp/service.env on first start.
ALPHA_DLP_POLICY_POLL_SEC=300
ALPHA_DLP_ALERT_SYNC_SEC=60
# Local blocker switches (true|false). false = this PC never applies that blocker,
# even when the server policy asks for it, and clears any leftover from earlier runs.
#   USB_BLOCK          USB mass-storage block (Security -> DLP Rules)
#   WEB_BLOCK          Web Blocker domains (/web-blocker)
#   NETWORK_LOCKDOWN   default-deny web firewall, outbound ports 80/443 (/allowlists/web)
#   APP_BLOCK          AppLocker app allowlist + running-app kill (/allowlists/apps)
ALPHA_DLP_USB_BLOCK=true
ALPHA_DLP_WEB_BLOCK=true
ALPHA_DLP_NETWORK_LOCKDOWN=true
ALPHA_DLP_APP_BLOCK=true
ALPHA_DLP_MAX_LOCAL_ALERTS=50000
ALPHA_DLP_DEDUP_SEC=300
# Relaunch the user-session tracker if Task Manager End Task kills it (SYSTEM service).
ALPHA_DLP_WATCHDOG=true
ALPHA_DLP_WATCHDOG_POLL_SEC=8

# Optional overrides (defaults = APP_IDENTIFIERS):
# ALPHA_DLP_DATA_DIR=
# ALPHA_DLP_PIPE_NAME=
# ALPHA_DEVICE_TOKEN=

